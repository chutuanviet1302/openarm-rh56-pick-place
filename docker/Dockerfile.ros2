# ROS 2 Humble environment for building/testing openarm_pick_place.
#
# Base is ros-base (not desktop): this milestone only needs colcon + rclpy to
# validate packaging and the pure-Python pipeline (fakes/geometry/models/motion/
# perception/pipeline). rviz, Gazebo etc. from "desktop" are not needed yet and
# roughly triple the image size. MoveIt 2 / realsense2_camera / cv_bridge are
# added here too since they are cheap compared to desktop and we'll need them
# for the next milestone (running the actual node executables against fakes).
#
# custom_ros_messages (MotorCmd/MotorCmds) is a lab-internal package, not on
# the ROS package index, so it is NOT installed here -- ros2_nodes.py will
# fail to import it until that package (or its .msg source) is provided.
FROM ros:humble-ros-base

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-colcon-common-extensions \
    python3-pip \
    python3-numpy \
    python3-pytest \
    ros-humble-cv-bridge \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    ros-humble-control-msgs \
    ros-humble-trajectory-msgs \
    ros-humble-moveit-msgs \
    ros-humble-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# MoveIt 2 and realsense2_camera are large (~1-2GB combined) and only needed
# once we actually run the perception/motion nodes end to end. Left commented
# so the base image stays small for the first "does it build/test" milestone;
# uncomment when moving to that step.
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     ros-humble-moveit \
#     ros-humble-realsense2-camera \
#     && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
SHELL ["/bin/bash", "-c"]

RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc
CMD ["/bin/bash"]
